{
  "include": [
    "electron/**/*",
    "electron.vite.config.ts",
    "src/lib/**/*",
    "src/types/**/*"
  ],
  "exclude": ["src/lib/export/**/*", "src/lib/narrative.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/types/*"],
      "@lib/*": ["src/lib/*"]
    }
  }
}
